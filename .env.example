# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true

# Protects POST /api/v1/messages/* (use a long random value)
INTERNAL_API_KEY=replace-with-at-least-32-random-characters

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=replace-with-channel-access-token
LINE_CHANNEL_SECRET=replace-with-channel-secret
LINE_DEFAULT_DESTINATION_USER_ID=
LINE_API_BASE_URL=https://api.line.me
LINE_REQUEST_TIMEOUT_SECONDS=10
LINE_MAX_RETRIES=2

